# Copy to .env and fill in real values for local docker-compose runs.
# .env is gitignored — never commit real secrets here.

# Backend connects to the database server(s) already running on your machine
# (Docker Desktop resolves host.docker.internal to the host).
SQLSERVER_CONNECTION_STRING=Server=host.docker.internal,1434;Database=MediPoint;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;
MONGO_CONNECTION_STRING=mongodb://host.docker.internal:27017

JWT_SECRET_KEY=ChangeThisToAStrongSecretKey!@#$
OPENAI_API_KEY=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=MediPoint
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# Browser-visible URL of the backend API (baked into the frontend build)
VITE_API_URL=http://localhost:8080
